# Postgres接続文字列（Prisma Postgresなど）
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# ログインセッション用の秘密鍵（ランダムな長い文字列にしてください）
JWT_SECRET="change-me-to-a-long-random-string"

# メール通知用（https://resend.com で発行）
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="EFK members <onboarding@resend.dev>"

# デプロイ後の公開URL（通知メール本文のリンクに使用、任意）
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Vercel Blob用（Vercelでプロジェクトに Blob ストアを接続すると自動で設定される）
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# プッシュ通知用（`npx web-push generate-vapid-keys --json` で発行。公開鍵はクライアントにも渡るためNEXT_PUBLIC_）
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxx"
VAPID_SUBJECT="mailto:admin@example.com"

# LINE通知用（LINE Official Account の Messaging API チャンネルで発行）
LINE_CHANNEL_ACCESS_TOKEN="xxxxxxxx"
LINE_CHANNEL_SECRET="xxxxxxxx"
# 「友だち追加」の案内リンク（LINE公式アカウントのベーシックID等から発行、任意）
NEXT_PUBLIC_LINE_ADD_FRIEND_URL="https://line.me/R/ti/p/@xxxxxxxx"
