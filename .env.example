# Supabase（DB・認証）
# Supabaseダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 試合フィードバックの自動削除バッチ（Vercel Cron）専用。「API Keys」の
# 「Legacy anon, service_role API keys」タブ、またはService Role用のキーから取得
SUPABASE_SERVICE_ROLE_KEY=

# 試合フィードバックの自動削除バッチ用の合言葉（自分で好きな文字列を決めてOK）
CRON_SECRET=

# Cloudflare R2（動画ストレージ）
# Cloudflareダッシュボード > R2 > バケット作成 > 「R2 APIトークンを管理」から取得
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
