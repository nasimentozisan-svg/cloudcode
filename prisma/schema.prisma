// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Category {
  TOP_PLAYER
  TOP_COACH
  SATELLITE_PLAYER
  SATELLITE_COACH
  U18_PLAYER
  U18_COACH
}

enum UniformSize {
  S
  M
  L
  XL
  XXL
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  uniformNumber       Int?
  cardImagePath       String?
  shirtSize           UniformSize?
  pantsSize           UniformSize?
  jerseySize          UniformSize?
  isAdmin             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  categories          UserCategory[]
  createdEvents       Event[]
  attendanceResponses AttendanceResponse[]
  createdChannels     Channel[]
  messages            Message[]
}

model UserCategory {
  id       String   @id @default(cuid())
  userId   String
  category Category
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model PendingCardImage {
  id            String   @id @default(cuid())
  filePath      String
  name          String
  uniformNumber Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AttendanceStatus {
  ATTENDING
  ABSENT
  UNDECIDED
}

model Event {
  id          String               @id @default(cuid())
  title       String
  location    String?
  notes       String?
  startAt     DateTime
  createdById String
  createdBy   User                 @relation(fields: [createdById], references: [id])
  categories  EventCategory[]
  responses   AttendanceResponse[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model EventCategory {
  id       String   @id @default(cuid())
  eventId  String
  category Category
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, category])
}

model AttendanceResponse {
  id          String           @id @default(cuid())
  eventId     String
  userId      String
  status      AttendanceStatus
  respondedAt DateTime         @updatedAt
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Channel {
  id          String            @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean           @default(false)
  isGlobal    Boolean           @default(false)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  categories  ChannelCategory[]
  messages    Message[]
  createdAt   DateTime          @default(now())
}

model ChannelCategory {
  id        String   @id @default(cuid())
  channelId String
  category  Category
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, category])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([channelId, createdAt])
}
