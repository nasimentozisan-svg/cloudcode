// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  TOP_PLAYER
  TOP_COACH
  SATELLITE_PLAYER
  SATELLITE_COACH
  U18_PLAYER
  U18_COACH
  GUARDIAN
  SUPPORTER
}

enum UniformSize {
  S
  M
  L
  XL
  XXL
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  passwordHash              String
  name                      String
  uniformNumber             Int?
  cardImagePath             String?
  shirtSize                 UniformSize?
  pantsSize                 UniformSize?
  jerseySize                UniformSize?
  receiveEmailNotifications Boolean              @default(true)
  calendarToken             String?              @unique
  lineUserId                String?              @unique
  lineLinkCode              String?              @unique
  guardianChildCategories   Category[]           @default([])
  isAdmin                   Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  categories                UserCategory[]
  createdEvents             Event[]
  attendanceResponses       AttendanceResponse[]
  createdChannels           Channel[]
  messages                  Message[]
  pushSubscriptions         PushSubscription[]
  channelReads              ChannelRead[]
  eventReads                EventRead[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model UserCategory {
  id       String   @id @default(cuid())
  userId   String
  category Category
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model PendingCardImage {
  id            String   @id @default(cuid())
  filePath      String
  name          String
  uniformNumber Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AttendanceStatus {
  ATTENDING
  MATCH_ONLY
  ABSENT
  UNDECIDED
}

model Event {
  id          String               @id @default(cuid())
  title       String
  location    String?
  notes       String?
  startAt     DateTime
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  categories  EventCategory[]
  responses   AttendanceResponse[]
  matchResult MatchResult?
  reads       EventRead[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model EventRead {
  id      String   @id @default(cuid())
  userId  String
  eventId String
  readAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model EventCategory {
  id       String   @id @default(cuid())
  eventId  String
  category Category
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, category])
}

model AttendanceResponse {
  id          String           @id @default(cuid())
  eventId     String
  userId      String
  status      AttendanceStatus
  respondedAt DateTime         @updatedAt
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model MatchResult {
  id            String        @id @default(cuid())
  eventId       String        @unique
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  opponent      String
  ourScore      Int
  opponentScore Int
  recordedById  String
  scorers       MatchScorer[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model MatchScorer {
  id            String      @id @default(cuid())
  matchResultId String
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  number        Int?
  name          String
  goals         Int         @default(1)
  order         Int         @default(0)
}

model Channel {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isDefault   Boolean           @default(false)
  isGlobal    Boolean           @default(false)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  categories  ChannelCategory[]
  messages    Message[]
  reads       ChannelRead[]
  createdAt   DateTime          @default(now())
}

model ChannelRead {
  id         String   @id @default(cuid())
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
}

model ChannelCategory {
  id        String   @id @default(cuid())
  channelId String
  category  Category
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, category])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
}
